        <mxCell id="p1-20" value="&lt;b&gt;ChromaDB&lt;/b&gt;&lt;br&gt;4 498 vecteurs bge-m3 (1024 d)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1000" y="130" width="210" height="80" as="geometry" /></mxCell>
