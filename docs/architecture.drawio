        <mxCell id="p1-15" value="&lt;b&gt;Recherche hybride&lt;/b&gt;&lt;br&gt;dense + BM25, fusion RRF" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="660" y="215" width="260" height="55" as="geometry" /></mxCell>
        <mxCell id="p1-16" value="&lt;b&gt;Reranking&lt;/b&gt; cross-encoder&lt;br&gt;15 candidats → 5 passages" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="660" y="310" width="260" height="55" as="geometry" /></mxCell>
        <mxCell id="p1-17" value="Prompt « réponse miroir »&lt;br&gt;règles : citer, ne rien inventer" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="660" y="405" width="260" height="55" as="geometry" /></mxCell>
        <mxCell id="p1-18" value="&lt;b&gt;LLM&lt;/b&gt; → réponse + sources&lt;br&gt;+ tokens + latence" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="660" y="500" width="260" height="55" as="geometry" /></mxCell>
