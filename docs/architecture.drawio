        <mxCell id="p3-1" value="Une question pas à pas" style="text;html=1;whiteSpace=wrap;fontSize=20;align=left;verticalAlign=middle;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1420" height="30" as="geometry" /></mxCell>
        <mxCell id="p3-2" value="Exemple : « What shaft seat tolerance class is recommended for rotating inner ring loads? » — chaque étape est mesurée par le banc." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1420" height="22" as="geometry" /></mxCell>
        <mxCell id="p3-3" value="&lt;b&gt;Question&lt;/b&gt;&lt;br&gt;langue détectée&lt;br&gt;(heuristique, sans dépendance)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="200" height="100" as="geometry" /></mxCell>
        <mxCell id="p3-4" value="1" style="ellipse;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fontColor=#ffffff;fillColor=#d79b00;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="30" y="118" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="p3-5" value="&lt;b&gt;Dense&lt;/b&gt; : bge-m3&lt;br&gt;15 voisins dans Chroma&lt;br&gt;(sens, synonymes, FR↔EN)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="290" y="130" width="200" height="100" as="geometry" /></mxCell>
        <mxCell id="p3-6" value="2" style="ellipse;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fontColor=#ffffff;fillColor=#d79b00;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="280" y="118" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="p3-7" value="&lt;b&gt;Fusion RRF&lt;/b&gt;&lt;br&gt;score = Σ 1 / (60 + rang)&lt;br&gt;pas de calibrage des scores" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="540" y="130" width="200" height="100" as="geometry" /></mxCell>
        <mxCell id="p3-8" value="3" style="ellipse;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fontColor=#ffffff;fillColor=#d79b00;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="530" y="118" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="p3-9" value="&lt;b&gt;Reranking&lt;/b&gt;&lt;br&gt;cross-encoder relit&lt;br&gt;(question, passage) → top 5" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="790" y="130" width="200" height="100" as="geometry" /></mxCell>
        <mxCell id="p3-10" value="4" style="ellipse;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fontColor=#ffffff;fillColor=#d79b00;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="780" y="118" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="p3-11" value="&lt;b&gt;Prompt&lt;/b&gt;&lt;br&gt;5 passages numérotés&lt;br&gt;+ consignes strictes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1040" y="130" width="200" height="100" as="geometry" /></mxCell>
        <mxCell id="p3-12" value="5" style="ellipse;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fontColor=#ffffff;fillColor=#d79b00;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1030" y="118" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="p3-13" value="&lt;b&gt;LLM local&lt;/b&gt;&lt;br&gt;réponse dans la langue&lt;br&gt;de la question + sources" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1290" y="130" width="200" height="100" as="geometry" /></mxCell>
        <mxCell id="p3-14" value="6" style="ellipse;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fontColor=#ffffff;fillColor=#d79b00;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1280" y="118" width="28" height="28" as="geometry" /></mxCell>
        <mxCell id="p3-15" value="&lt;b&gt;BM25&lt;/b&gt; : mots exacts&lt;br&gt;15 meilleurs passages&lt;br&gt;(désignations : NU 311, SNL…)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="290" y="300" width="200" height="100" as="geometry" /></mxCell>
