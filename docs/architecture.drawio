        <mxCell id="p2-18" value="Pourquoi page par page ? Chaque réponse peut citer « fichier + page » : le technicien rouvre le PDF au bon endroit pour voir le schéma ou le tableau d&#x27;origine." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="1300" height="40" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p3" name="3. Une question pas à pas">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="640" math="0" shadow="0">
