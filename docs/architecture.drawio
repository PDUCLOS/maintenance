        <mxCell id="p1-23" value="&lt;b&gt;Embeddings bge-m3&lt;/b&gt; (ingestion + question)&lt;br&gt;Mac : sentence-transformers (MPS)&lt;br&gt;PC : Ollama (GPU)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1230" y="290" width="210" height="90" as="geometry" /></mxCell>
