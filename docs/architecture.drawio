  <diagram id="p2" name="2. Ingestion des catalogues">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2-1" value="Ingestion : des PDF aux vecteurs (python -m src.ingestion.pipeline)" style="text;html=1;whiteSpace=wrap;fontSize=20;align=left;verticalAlign=middle;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1420" height="30" as="geometry" /></mxCell>
        <mxCell id="p2-2" value="Mesuré sur ce PC : 2 catalogues SKF publics, 1 734 pages → 4 498 chunks, 247,6 s de bout en bout (embeddings bge-m3 sur GPU via Ollama ≈ 2 min 23 s)." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1420" height="22" as="geometry" /></mxCell>
        <mxCell id="p2-3" value="&lt;b&gt;Catalogues PDF&lt;/b&gt;&lt;br&gt;data/raw/pdf/&lt;br&gt;(non versionnés : licence fabricant)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="220" height="90" as="geometry" /></mxCell>
        <mxCell id="p2-4" value="&lt;b&gt;PyMuPDF&lt;/b&gt;&lt;br&gt;texte page par page&lt;br&gt;(n° de page conservé)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="320" y="120" width="200" height="90" as="geometry" /></mxCell>
        <mxCell id="p2-5" value="&lt;b&gt;Découpage récursif&lt;/b&gt;&lt;br&gt;500 tokens, chevauchement 50&lt;br&gt;paragraphe → ligne → phrase" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="120" width="230" height="90" as="geometry" /></mxCell>
        <mxCell id="p2-6" value="&lt;b&gt;Embeddings bge-m3&lt;/b&gt;&lt;br&gt;multilingue FR/EN, 1024 d&lt;br&gt;normalisés L2" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="870" y="120" width="210" height="90" as="geometry" /></mxCell>
        <mxCell id="p2-7" value="&lt;b&gt;ChromaDB&lt;/b&gt;&lt;br&gt;collection bearings_kb&lt;br&gt;(serveur ou disque local)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1140" y="110" width="220" height="110" as="geometry" /></mxCell>
        <mxCell id="p2-8" value="&lt;b&gt;chunks.jsonl&lt;/b&gt;&lt;br&gt;trace d&#x27;audit,&lt;br&gt;ré-embedding sans re-parser" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="330" width="230" height="100" as="geometry" /></mxCell>
        <mxCell id="p2-9" value="&lt;b&gt;Index BM25&lt;/b&gt;&lt;br&gt;construit au 1er appel,&lt;br&gt;mis en cache (hash du corpus)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1140" y="330" width="220" height="100" as="geometry" /></mxCell>
        <mxCell id="p2-10" value="Identifiant stable par chunk :&lt;br&gt;&lt;code&gt;pdf:FICHIER.pdf:p42:0&lt;/code&gt;&lt;br&gt;→ ré-ingestion idempotente (upsert)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="870" y="330" width="210" height="100" as="geometry" /></mxCell>
        <mxCell id="p2-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-3" target="p2-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p2-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-4" target="p2-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p2-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-5" target="p2-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
