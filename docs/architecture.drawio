  <diagram id="p1" name="1. Vue d&#x27;ensemble">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1-1" value="Copilote maintenance — vue d&#x27;ensemble" style="text;html=1;whiteSpace=wrap;fontSize=20;align=left;verticalAlign=middle;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1420" height="30" as="geometry" /></mxCell>
        <mxCell id="p1-2" value="Une question en langage naturel → les passages les plus pertinents des catalogues → une réponse sourcée, générée par un LLM local. Aucune donnée ne sort de la machine." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1420" height="22" as="geometry" /></mxCell>
        <mxCell id="p1-3" value="Utilisateurs" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="260" height="560" as="geometry" /></mxCell>
        <mxCell id="p1-4" value="&lt;b&gt;Technicien / ingénieur maintenance&lt;/b&gt;&lt;br&gt;question en français ou en anglais" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="p1-5" value="&lt;b&gt;Interface Streamlit&lt;/b&gt; :8501&lt;br&gt;Chat · Inventaire · RAGAS · Index" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="p1-6" value="&lt;b&gt;Démo web statique&lt;/b&gt;&lt;br&gt;web/demo.html (?api=…)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="390" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="p1-7" value="&lt;b&gt;Banc LLMOps&lt;/b&gt;&lt;br&gt;scripts/llmops_bench.py&lt;br&gt;appelle la chaîne directement" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="p1-8" value="API FastAPI (src/api)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="340" y="90" width="260" height="560" as="geometry" /></mxCell>
        <mxCell id="p1-9" value="&lt;b&gt;POST /query&lt;/b&gt; (+ /v1/query)&lt;br&gt;délai max 60 s → 504" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="360" y="130" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="p1-10" value="&lt;b&gt;GET /health&lt;/b&gt;&lt;br&gt;Chroma + LLM prêts ?" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="360" y="230" width="220" height="55" as="geometry" /></mxCell>
        <mxCell id="p1-11" value="&lt;b&gt;GET /metrics&lt;/b&gt;&lt;br&gt;format Prometheus" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="360" y="320" width="220" height="55" as="geometry" /></mxCell>
        <mxCell id="p1-12" value="&lt;b&gt;/ingest · /eval · /index&lt;/b&gt;&lt;br&gt;ingestion, RAGAS, inventaire" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="360" y="410" width="220" height="60" as="geometry" /></mxCell>
        <mxCell id="p1-13" value="Chaîne RAG (src/rag, LangChain LCEL)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="90" width="300" height="560" as="geometry" /></mxCell>
