        <mxCell id="p3-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-3" target="p3-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p3-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-15" target="p3-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p3-23" value="&lt;b&gt;Réponse API&lt;/b&gt;&lt;br&gt;answer · sources (fichier, page, score)&lt;br&gt;language · usage (tokens) · latency_ms" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="790" y="300" width="700" height="80" as="geometry" /></mxCell>
        <mxCell id="p3-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3-13" target="p3-23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p3-25" value="Garde-fous : hors corpus → « I don&#x27;t know from the available data » ; aucune valeur numérique inventée ; vocabulaire métier (jamais « chunk », « embedding »…) ; délai maximal 60 s côté API." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="1450" height="44" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p4" name="4. Backends interchangeables">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="660" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p4-1" value="Même code, deux machines : le backend se choisit par variable d&#x27;environnement" style="text;html=1;whiteSpace=wrap;fontSize=20;align=left;verticalAlign=middle;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1420" height="30" as="geometry" /></mxCell>
        <mxCell id="p4-2" value="MLX n&#x27;existe que sur Apple Silicon. Le provider Ollama ajouté ici fait tourner la même chaîne sous Windows / Linux, sans toucher au chemin Mac d&#x27;origine." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1420" height="22" as="geometry" /></mxCell>
        <mxCell id="p4-3" value="Mac Apple Silicon (configuration d&#x27;origine)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="420" height="400" as="geometry" /></mxCell>
        <mxCell id="p4-4" value="LLM_PROVIDER=&lt;b&gt;mlx&lt;/b&gt;&lt;br&gt;Qwen2.5-7B-Instruct 4 bits (Metal)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="380" height="60" as="geometry" /></mxCell>
        <mxCell id="p4-5" value="EMBED_PROVIDER=&lt;b&gt;sentence_transformers&lt;/b&gt;&lt;br&gt;bge-m3 sur MPS" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="380" height="60" as="geometry" /></mxCell>
        <mxCell id="p4-6" value="TORCH_DEVICE=&lt;b&gt;mps&lt;/b&gt; (reranker)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="380" height="50" as="geometry" /></mxCell>
        <mxCell id="p4-7" value="CHROMA_MODE=&lt;b&gt;http&lt;/b&gt;&lt;br&gt;serveur Chroma dans Docker" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="370" width="380" height="60" as="geometry" /></mxCell>
        <mxCell id="p4-8" value="Non ré-exécuté dans cette session (pas de Mac)." style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="380" height="30" as="geometry" /></mxCell>
        <mxCell id="p4-9" value="Code commun (inchangé)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="540" y="100" width="420" height="400" as="geometry" /></mxCell>
        <mxCell id="p4-10" value="&lt;b&gt;get_chat_model()&lt;/b&gt;&lt;br&gt;src/rag/llm.py" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="560" y="150" width="380" height="60" as="geometry" /></mxCell>
        <mxCell id="p4-11" value="&lt;b&gt;Embedder&lt;/b&gt; · &lt;b&gt;VectorStore&lt;/b&gt; · &lt;b&gt;Reranker&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="560" y="240" width="380" height="50" as="geometry" /></mxCell>
        <mxCell id="p4-12" value="&lt;b&gt;RAGChain&lt;/b&gt; · &lt;b&gt;HybridRetriever&lt;/b&gt; · API · UI" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="560" y="320" width="380" height="50" as="geometry" /></mxCell>
        <mxCell id="p4-13" value="settings.assert_backend_supported()&lt;br&gt;refuse MLX hors Apple Silicon (échec explicite)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="560" y="400" width="380" height="60" as="geometry" /></mxCell>
        <mxCell id="p4-14" value="PC Windows 11 + RTX 4070 Ti SUPER (cette session)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1040" y="100" width="420" height="400" as="geometry" /></mxCell>
        <mxCell id="p4-15" value="LLM_PROVIDER=&lt;b&gt;ollama&lt;/b&gt;&lt;br&gt;qwen3.5:9b (GPU, think=false)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1060" y="140" width="380" height="60" as="geometry" /></mxCell>
        <mxCell id="p4-16" value="EMBED_PROVIDER=&lt;b&gt;ollama&lt;/b&gt;&lt;br&gt;bge-m3 via /api/embed" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1060" y="220" width="380" height="60" as="geometry" /></mxCell>
        <mxCell id="p4-17" value="TORCH_DEVICE=&lt;b&gt;auto&lt;/b&gt; → cpu ici (torch CPU)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1060" y="300" width="380" height="50" as="geometry" /></mxCell>
        <mxCell id="p4-18" value="CHROMA_MODE=&lt;b&gt;persistent&lt;/b&gt;&lt;br&gt;base embarquée sur disque, sans Docker" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1060" y="370" width="380" height="60" as="geometry" /></mxCell>
        <mxCell id="p4-19" value="Testé ici : suite pytest + banc complet." style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=middle;fontColor=#2d7a2d;" vertex="1" parent="1"><mxGeometry x="1060" y="450" width="380" height="30" as="geometry" /></mxCell>
        <mxCell id="p4-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-15" target="p4-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p4-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-16" target="p4-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p4-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-18" target="p4-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p4-23" value="Correctifs de reproductibilité trouvés en installant à neuf : pyarrow et anyio non épinglés (incompatibles avec numpy 1.26 / starlette 0.41), chroma-hnswlib sans roue Windows." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="1420" height="44" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p5" name="5. Banc LLMOps">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p5-1" value="Banc LLMOps : comment les chiffres de la vitrine sont produits" style="text;html=1;whiteSpace=wrap;fontSize=20;align=left;verticalAlign=middle;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="1420" height="30" as="geometry" /></mxCell>
        <mxCell id="p5-2" value="scripts/build_gold_set.py puis scripts/llmops_bench.py — résultats bruts dans reports/llmops/latest.json." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="48" width="1420" height="22" as="geometry" /></mxCell>
        <mxCell id="p5-3" value="&lt;b&gt;Pages de catalogue&lt;/b&gt;&lt;br&gt;riches en texte, tirées&lt;br&gt;au sort (graine 42)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="200" height="90" as="geometry" /></mxCell>
        <mxCell id="p5-4" value="&lt;b&gt;gemma4:e4b&lt;/b&gt; écrit 1 question&lt;br&gt;précise par page&lt;br&gt;(1 sur 3 en français)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="300" y="130" width="220" height="90" as="geometry" /></mxCell>
        <mxCell id="p5-5" value="&lt;b&gt;30 questions&lt;/b&gt;&lt;br&gt;« page connue »&lt;br&gt;data/eval/" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="580" y="125" width="180" height="100" as="geometry" /></mxCell>
        <mxCell id="p5-6" value="&lt;b&gt;25 questions&lt;/b&gt;&lt;br&gt;jeu d&#x27;origine&lt;br&gt;(src/eval/dataset.py)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="330" y="300" width="180" height="100" as="geometry" /></mxCell>
        <mxCell id="p5-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5-3" target="p5-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="p5-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#555555;fontSize=11;fontColor=#333333;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p5-4" target="p5-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
